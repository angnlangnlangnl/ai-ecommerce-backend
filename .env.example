DEEPSEEK_API_KEY=sk-your-key-here

# Agnes（图片/视频生成、多模态反解）
AGNES_API_KEY=sk-XmLjN9e3Mhh8wf
AGNES_VL_MODEL=agnes-vl-2.0

# ==================== ★ 关键：公共访问地址 ====================
# Railway 部署时必须设置，用于生成正确的 HTTPS 图片/视频 URL
# 手机端图片不显示的核心原因就是这里没设置
PUBLIC_BASE_URL=https://ai-ecommerce-backend-production-0776.up.railway.app

# ==================== 目录与存储 ====================
TEMP_UPLOAD_DIR=temp_uploads
TEMP_FILE_TTL=3600
UPLOAD_DIR=uploads

# ==================== 服务 ====================
# Railway 会自动注入 PORT，本地可不填
# PORT=8000
